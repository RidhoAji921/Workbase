<Page x:Class="Workbase.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="#F7F8FC">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="32">

            <!-- Page Header -->
            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#20243A"/>

            <TextBlock Text="Configure your Workbase experience."
                       FontSize="14"
                       Foreground="#777E91"
                       Margin="0,8,0,28"/>

            <!-- General Section -->
            <Border Background="White"
                    BorderBrush="#E1E5EE"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="General"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#20243A"/>

                    <TextBlock Text="Application preferences and behavior."
                               FontSize="13"
                               Foreground="#777E91"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Data & Storage Section -->
            <Border Background="White"
                    BorderBrush="#E1E5EE"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,0,20">

                <StackPanel>
                    <TextBlock Text="Data &amp; Storage"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#20243A"/>

                    <TextBlock Text="Manage your local data and database."
                               FontSize="13"
                               Foreground="#777E91"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- About Section -->
            <Border Background="White"
                    BorderBrush="#E1E5EE"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24">

                <StackPanel>
                    <TextBlock Text="About Workbase"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#20243A"/>

                    <TextBlock Text="Application information and version."
                               FontSize="13"
                               Foreground="#777E91"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
