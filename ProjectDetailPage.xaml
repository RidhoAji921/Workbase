<Page x:Class="Workbase.ProjectDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Project Detail"
      Background="#F5F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="34,30,34,36">

            <!-- Back button -->
            <Button Content="←  Back to Projects"
                    HorizontalAlignment="Left"
                    Padding="12,8"
                    Margin="0,0,0,26"
                    Background="White"
                    BorderBrush="#E8EAF1"
                    Click="BackToProjects_Click"/>

            <!-- Project header -->
            <Border Background="White"
                    BorderBrush="#E8EAF1"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="26">

                <StackPanel>
                    <Border Background="#E8E7FF"
                            CornerRadius="9"
                            Padding="11"
                            HorizontalAlignment="Left">
                        <TextBlock Text="PROJECT"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#4F46E5"/>
                    </Border>

                    <TextBlock x:Name="ProjectNameText"
                               Text="Project Name"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#20243A"
                               TextWrapping="Wrap"
                               Margin="0,20,0,8"/>

                    <TextBlock x:Name="ProjectDescriptionText"
                               Text="Project description"
                               FontSize="14"
                               Foreground="#777E91"
                               TextWrapping="Wrap"/>

                    <Border Height="1"
                            Background="#E8EAF1"
                            Margin="0,24,0,20"/>

                    <TextBlock Text="Project Overview"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#20243A"/>

                    <TextBlock Text="This is your project workspace. You will be able to manage tasks and track progress here."
                               FontSize="13"
                               Foreground="#777E91"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>


            <!-- Tasks section -->
            <Grid Margin="0,30,0,16">
                <StackPanel>
                    <TextBlock Text="Tasks"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#20243A"/>

                    <TextBlock x:Name="TaskCountText"
                   Text="0 tasks"
                   FontSize="12"
                   Foreground="#777E91"
                   Margin="0,5,0,0"/>
                </StackPanel>

                <Button Content="+  Add Task"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Padding="15,10"
            Background="#4F46E5"
            Foreground="White"
            BorderThickness="0"
            Click="AddTask_Click"/>
            </Grid>

            <TextBlock x:Name="EmptyTasksText"
           Text="No tasks yet. Create your first task."
           FontSize="13"
           Foreground="#777E91"
           Margin="0,4,0,16"
           Visibility="Collapsed"/>

            <ItemsControl x:Name="TasksItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                    BorderBrush="#E8EAF1"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,0,12">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#20243A"
                                   TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Description}"
                                   FontSize="12"
                                   Foreground="#777E91"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,10"/>

                                    <TextBlock Text="{Binding Status}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#4F46E5"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                                    <Button Content="Edit"
                                Padding="12,7"
                                Margin="0,0,8,0"
                                Click="EditTask_Click"/>

                                    <Button Content="Delete"
                                Padding="12,7"
                                Foreground="#DC2626"
                                Click="DeleteTask_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <Border Background="White"
                    BorderBrush="#E8EAF1"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="No tasks yet"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#20243A"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Tasks for this project will appear here."
                               FontSize="12"
                               Foreground="#777E91"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
