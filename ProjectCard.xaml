<UserControl x:Class="Workbase.ProjectCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="220">

    <Border Background="White"
            BorderBrush="#E8EAF1"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18"
            Margin="0,0,14,14">

        <StackPanel>
            <!-- Project icon -->
            <Border Background="#E8E7FF"
                    CornerRadius="8"
                    Padding="9"
                    HorizontalAlignment="Left">
                <TextBlock Text="PR"
                           Foreground="#4F46E5"
                           FontWeight="Bold"/>
            </Border>

            <!-- Project name -->
            <TextBlock Text="{Binding Name}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#20243A"
                       Margin="0,16,0,7"
                       TextWrapping="Wrap"/>

            <!-- Project description -->
            <TextBlock Text="{Binding Description}"
                       FontSize="12"
                       Foreground="#777E91"
                       TextWrapping="Wrap"
                       MinHeight="36"/>

            <!-- Project deadline -->
            <TextBlock Text="{Binding Deadline,
                                     StringFormat='Deadline: {0:dd MMM yyyy}'}"
                       FontSize="12"
                       Foreground="#777E91"
                       Margin="0,12,0,0"/>

            <!-- Project status -->
            <TextBlock Text="{Binding Status}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#4F46E5"
                       Margin="0,8,0,0"/>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">

                <Button Content="Open"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Click="OpenProject_Click"/>

                <Button Content="Edit"
                        Padding="12,7"
                        Margin="0,0,8,0"
                        Click="EditProject_Click"/>

                <Button Content="Delete"
                        Padding="12,7"
                        Foreground="#DC2626"
                        Click="DeleteProject_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
