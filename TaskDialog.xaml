<Window x:Class="Workbase.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Border Background="White"
            Padding="26"
            Margin="12"
            CornerRadius="12">

        <StackPanel>
            <TextBlock x:Name="DialogTitle"
                       Text="Create Task"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#20243A"/>

            <TextBlock Text="Title"
                       Margin="0,24,0,7"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="TitleTextBox"
                     Height="38"
                     Padding="9"
                     FontSize="13"/>

            <TextBlock Text="Description (Optional)"
                       Margin="0,18,0,7"
                       FontWeight="SemiBold"/>

            <TextBox x:Name="DescriptionTextBox"
                     MinHeight="80"
                     Padding="9"
                     FontSize="13"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Status"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="StatusComboBox"
                              Height="36"
                              Padding="8"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Priority"
                               Margin="0,0,0,7"
                               FontWeight="SemiBold"/>

                    <ComboBox x:Name="PriorityComboBox"
                              Height="36"
                              Padding="8">
                        <ComboBoxItem Content="Low"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="High"/>
                        <ComboBoxItem Content="Urgent"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Deadline (Optional)"
                       Margin="0,18,0,7"
                       FontWeight="SemiBold"/>

            <DatePicker x:Name="DeadlineDatePicker"
                        Height="36"
                        Padding="6"/>

            <Button x:Name="ClearDeadlineButton"
                    Content="Clear deadline"
                    HorizontalAlignment="Left"
                    Margin="0,5,0,0"
                    Padding="0,3"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#6366F1"
                    Cursor="Hand"
                    Click="ClearDeadline_Click"/>

            <TextBlock x:Name="ErrorText"
                       Foreground="#DC2626"
                       FontSize="12"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">

                <Button Content="Cancel"
                        Padding="16,9"
                        Margin="0,0,10,0"
                        IsCancel="True"/>

                <Button Content="Save Task"
                        Padding="16,9"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderThickness="0"
                        IsDefault="True"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
