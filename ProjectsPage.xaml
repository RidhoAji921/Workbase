<Page x:Class="Workbase.ProjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Projects"
      Background="#F5F7FB">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">

            <!-- Page header -->
            <Grid Margin="0,0,0,28">
                <StackPanel>
                    <TextBlock Text="Projects"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#20243A"/>

                    <TextBlock Text="Manage all your projects in one place."
                               FontSize="13"
                               Foreground="#777E91"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Button Content="+  Add Project"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="16,11"
                        Background="#4F46E5"
                        Foreground="White"
                        BorderThickness="0"
                        Click="AddProject_Click"/>
            </Grid>

            <!-- Search -->
            <TextBox x:Name="SearchTextBox"
                     Height="40"
                     Padding="12,9"
                     FontSize="13"
                     BorderBrush="#E1E4ED"
                     Background="White"
                     ToolTip="Search projects"
                     TextChanged="SearchTextBox_TextChanged"
                     Margin="0,0,0,22"/>

            <!-- Project count -->
            <TextBlock x:Name="ProjectCountText"
                       Text="Projects"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#20243A"
                       Margin="0,0,0,14"/>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyText"
                       Text="No projects found. Create a project to get started."
                       Foreground="#777E91"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,8,0,20"
                       Visibility="Collapsed"/>

            <!-- Project cards -->
            <ItemsControl x:Name="ProjectsItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White"
                                BorderBrush="#E8EAF1"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,14,14">

                            <StackPanel>
                                <Border Background="#E8E7FF"
                                        CornerRadius="8"
                                        Padding="9"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="PR"
                                               Foreground="#4F46E5"
                                               FontWeight="Bold"/>
                                </Border>

                                <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#20243A"
                                           Margin="0,16,0,7"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding Description}"
                                           FontSize="12"
                                           Foreground="#777E91"
                                           TextWrapping="Wrap"
                                           MinHeight="36"/>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,18,0,0">

                                    <Button Content="Open"
                                            Padding="12,7"
                                            Margin="0,0,8,0"
                                            Click="OpenProject_Click"/>

                                    <Button Content="Edit"
                                            Padding="12,7"
                                            Margin="0,0,8,0"
                                            Click="EditProject_Click"/>

                                    <Button Content="Delete"
                                            Padding="12,7"
                                            Foreground="#DC2626"
                                            Click="DeleteProject_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
