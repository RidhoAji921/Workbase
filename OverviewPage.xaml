<Page x:Class="Workbase.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Workbase"
      Background="#F5F7FB">

    <Page.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="TextBrush" Color="#20243A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#777E91"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E8EAF1"/>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#454B60"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="DashboardContent"
              Grid.Column="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="34,30,34,36">

            <!-- Header -->
            <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                            Margin="0,0,0,30">
                <TextBlock Text="Overview"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Here's what's happening with your work today."
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,7,0,0"/>
            </StackPanel>

            <!-- Summary cards -->
            <UniformGrid Columns="3" Margin="0,0,0,30">

                <Border Background="White"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Total Tasks"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"/>

                        <TextBlock Text="12"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"
                                       Margin="0,12,0,6"/>

                        <TextBlock Text="Across all projects"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="In Progress"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"/>

                        <TextBlock Text="4"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#D97706"
                                       Margin="0,12,0,6"/>

                        <TextBlock Text="Tasks being worked on"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="20"
                            Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Completed"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedBrush}"/>

                        <TextBlock Text="8"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#16A34A"
                                       Margin="0,12,0,6"/>

                        <TextBlock Text="Tasks finished"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Projects section header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="My Projects"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="Keep track of your ongoing work."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+  Add Project"
                        Style="{StaticResource PrimaryButtonStyle}"
                        VerticalAlignment="Center"
                        Click="AddProject_Click"/>
            </Grid>

            <!-- Dynamic project cards -->
            <ItemsControl x:Name="ProjectsItemsControl"
                    Margin="0,0,0,32">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:ProjectCard Loaded="ProjectCard_Loaded"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <!-- Recent tasks header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Recent Tasks"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="A quick look at your latest tasks."
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                            Content="View All →"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Center"/>
            </Grid>

            <!-- Task list -->
            <Border Background="White"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">

                <StackPanel>

                    <!-- Task 1 -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Build dashboard layout"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Workbase"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                       Text="High"
                                       FontSize="11"
                                       Foreground="#DC2626"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                        <Border Grid.Column="2"
                                    Background="#FFF0D9"
                                    CornerRadius="6"
                                    Padding="9,5"
                                    VerticalAlignment="Center">
                            <TextBlock Text="In Progress"
                                           FontSize="10"
                                           Foreground="#B45309"
                                           HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Border Height="1"
                                Background="{StaticResource LineBrush}"
                                Margin="0,16"/>

                    <!-- Task 2 -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Set up local database"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Workbase"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                       Text="Medium"
                                       FontSize="11"
                                       Foreground="#B45309"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                        <Border Grid.Column="2"
                                    Background="#DDF7E8"
                                    CornerRadius="6"
                                    Padding="9,5"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Completed"
                                           FontSize="10"
                                           Foreground="#15803D"
                                           HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Border Height="1"
                                Background="{StaticResource LineBrush}"
                                Margin="0,16"/>

                    <!-- Task 3 -->
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Design task creation form"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Workbase"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,5,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                       Text="Low"
                                       FontSize="11"
                                       Foreground="#15803D"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>

                        <Border Grid.Column="2"
                                    Background="#E8EAF1"
                                    CornerRadius="6"
                                    Padding="9,5"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Todo"
                                           FontSize="10"
                                           Foreground="#596174"
                                           HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                </StackPanel>
            </Border>

            <TextBlock Text="Workbase · Personal Workspace"
                           FontSize="11"
                           Foreground="#9BA1B1"
                           HorizontalAlignment="Center"
                           Margin="0,28,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Page>