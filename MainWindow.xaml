<Window x:Class="Workbase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Workbase"
        Width="1280"
        Height="750"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FB"
        WindowState="Maximized">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F46E5"/>
        <SolidColorBrush x:Key="TextBrush" Color="#20243A"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#777E91"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="LineBrush" Color="#E8EAF1"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#777E91"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#454B60"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E8EAF1"
                BorderThickness="0,0,1,0">

            <Grid Margin="22,26,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">
                    <Border Width="36"
                            Height="36"
                            Background="#4F46E5"
                            CornerRadius="10">
                        <TextBlock Text="W"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center"
                                Margin="11,0,0,0">
                        <TextBlock Text="Workbase"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="WORKSPACE"
                                   FontSize="9"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="WORKSPACE"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#9BA1B1"
                               Margin="10,0,0,12"/>

                    <Button x:Name="OverviewButton"
                            Content="▦    Overview"
                            Style="{StaticResource NavButtonStyle}"
                            Background="#EFEEFF"
                            Foreground="#4F46E5"
                            FontWeight="SemiBold"
                            Click="Overview_Click"/>

                    <Button 
                         x:Name="MyTaskButton"
                        Content="☷    My Tasks"
                            Style="{StaticResource NavButtonStyle}"
                        Click="MyTasks_Click"/>

                    <Button x:Name="ProjectsButton"
                            Content="▣    Projects"
                            Style="{StaticResource NavButtonStyle}"
                            Click="Projects_Click"/>

                    <TextBlock Text="PREFERENCES"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#9BA1B1"
                               Margin="10,28,0,12"/>

                    <Button  x:Name="SettingsButton"
                        Content="⚙    Settings"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SettingsButton_Click"/>
                </StackPanel>

                <!-- Bottom profile -->
                <Border Grid.Row="4"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,18,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38"
                                Height="38"
                                Background="#E5E7FF"
                                CornerRadius="20">
                            <TextBlock Text="U"
                                       Foreground="#4F46E5"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center"
                                    Margin="10,0,0,0">
                            <TextBlock Text="Your Workspace"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="Personal account"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->

        <!-- PAGE NAVIGATION -->
        <Frame x:Name="MainFrame"
           Grid.Column="1"
           NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
